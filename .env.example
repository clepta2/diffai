# ==============================================================================
# DIFFAI — AMBIENTE & CHAVES MESTRE DE INTELIGÊNCIA ARTIFICIAL
# ==============================================================================

# Chave Mestre DiffAI (Permite ao Antigravity e agentes acessarem o orquestrador)
DIFFAI_API_KEY=sk-diffai-master-key-change-me

# Gateway OmniRouter / Provedor Local
OMNIROUTER_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTER_API_KEY=sk-diffai-SUA-CHAVE-MESTRE-AQUI

# Provedores de Reserva (Failover em Cascata Automática)
# Múltiplas chaves podem ser passadas separadas por vírgula para Pool Anti-429
NVIDIA_KEYS=
GROQ_KEYS=
GEMINI_KEYS=
OPENROUTER_KEYS=
POLLINATIONS_KEYS=

# Backend de Dados & Memória Persistente Multi-Tenant (Supabase PostgreSQL + RLS)
SUPABASE_URL=https://db.ozpro.com.br
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Armazenamento Dedicado de Mídias (rmount / 5TB Drive)
STORAGE_BACKEND_URL=https://app.ozpro.com.br
STORAGE_ROOT=/mnt/gdrive/ozpro-media

# Configurações do Servidor Local
PORT=3030
NODE_ENV=production

